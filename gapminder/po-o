:root {
  --color-primary: #000;
  --color-grey: #ccc;
  --color-grey-medium: #b2b2b2;
  --color-grey-light: #ecebe9;
  --color-black: #222;
  --color-blue-dark: #607889;
  --color-blue-darker: #425663;
  --color-barely-visible: #f5f9fb;
  --color-button-border: #000;
  --color-button-background: #fff;
  --color-button-inset: #fff;
  --color-button-hover: #fff;
  --color-footer-text: #666;
  --color-background: #fff;
  --color-footer-link: #3071a0;
  --color-logotext: #000;
  --color-menutext: #222;
  --color-chartswitchertext: #000;
  --body-min-width: 250px;
  --header-height-small: 32px;
  --header-height-large: 32px;
  --header-height-xlarge: 50px;
  --theme-font-heading: "Brand Sans Heading", var(--fallback-font-heading);
  --theme-font-body: "Brand Sans Body", var(--fallback-font-body);
  --theme-font-alt: "Brand Sans Alt", var(--fallback-font-alt);
  --theme-font-mono: "Brand Mono", var(--fallback-font-mono);
}
:root {
  --header-height: var(--header-height-xlarge, 50px);
}
@media (max-width: 1024px) {
  :root {
    --header-height: var(--header-height-large, 32px);
  }
}
@media (max-width: 728px) {
  :root {
    --header-height: var(--header-height-small, 32px);
  }
}
.vzb-tool {
  --vzb-font-family: var(--theme-font-body, "Brand Sans Body", var(--fallback-font-body));
  --vzb-font-family-alt: var(--theme-font-alt, "Brand Sans Alt", var(--fallback-font-alt));
  --vzb-font-family-mono: var(--theme-font-mono, "Brand Mono", var(--fallback-font-mono));
}
.vzb-tool-buttonlist,
.vzb-dialog-zoom-buttonlist,
.vzb-tool-dialogs,
.vzb-sidebar,
.vzb-dialog-checkbox label:before {
  background-color: #fff !important;
}
.vzb-dialogs-dialog.vzb-sidebar {
  margin: 5px 0 2px -5px !important;
}
.vzb-dialog-shadow {
  border-top: none !important;
  border-bottom: none !important;
}
* {
  box-sizing: border-box;
}
html,
body {
  height: 100%;
  text-rendering: optimizeLegibility;
  font-variant-numeric: tabular-nums slashed-zero;
}
