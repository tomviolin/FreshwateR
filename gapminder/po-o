  background-color: #fff;
  font-family: var(--theme-font-body, "Brand Sans Body", var(--fallback-font-body));
  font-size: 16px;
  min-width: var(--body-min-width, 250px);
  padding: 0;
  margin: 0;
}
@media (max-width: 728px) {
  body {
    font-size: 14px;
